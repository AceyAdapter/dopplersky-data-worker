DATABASE_URL=postgresql://dopplersky:dopplersky@localhost:5433/dopplersky
APPVIEW_URL=https://public.api.bsky.app
# Tap is mothballed in audience v2 (D17): audience capture is forward-only via
# Jetstream, no repository backfill. These stay for a possible future
# historical-backfill phase; the worker does not start Tap.
TAP_URL=http://localhost:2480
TAP_ADMIN_PASSWORD=change-me
API_SYNC_URL=http://localhost:3001/internal/worker-sync
API_SYNC_TOKEN=change-me
WORKER_ID=local-1
POLL_CONCURRENCY=8
JOB_LEASE_SECONDS=120
# Live post-launch tracking via Jetstream (default on). Set to off to rely only
# on the polling discovery paths.
POST_LAUNCH_TRACKING_ENABLED=true
JETSTREAM_ENDPOINT=wss://jetstream2.us-east.bsky.network/subscribe
FOLLOWER_SAMPLE_SIZE=2000
FOLLOWER_FULL_SCAN_LIMIT=50000
FOLLOWER_REFRESH_HOURS=24
ENGAGER_SCAN_PAGE_LIMIT=100
# Audience intelligence v2 (opt-in via AUDIENCE_COLLECTION_ENABLED, default off).
# Forward-only Jetstream capture of a bounded, rotating engager cohort (D17).
AUDIENCE_COLLECTION_ENABLED=false
AUDIENCE_WATCH_PER_TARGET=300
AUDIENCE_WATCH_GLOBAL_CAP=5000
AUDIENCE_SCAN_TOP_POSTS=10
AUDIENCE_SCAN_RECENT_POSTS=15
AUDIENCE_SCAN_PAGES_PER_POST=3
AUDIENCE_HYDRATE_LIMIT=200
SYNC_BATCH_SIZE=500
# Optional local operator pulse. A password is mandatory when enabled; root
# Compose enables it and supplies its local-only default separately.
WORKER_DASHBOARD_ENABLED=false
WORKER_DASHBOARD_HOST=127.0.0.1
WORKER_DASHBOARD_PORT=3002
WORKER_DASHBOARD_USERNAME=dopplersky
WORKER_DASHBOARD_PASSWORD=
WORKER_DASHBOARD_REFRESH_MS=2000

# Lifecycle email dispatch (trial ending / trial ended). The worker only holds
# the clock: it POSTs the API's notification route, which owns the recipients,
# the templates and the SMTP settings. Unset = no dispatch at all.
NOTIFICATIONS_URL=http://localhost:3001/api/dopplersky/notifications/run
NOTIFICATIONS_TOKEN=change-me
